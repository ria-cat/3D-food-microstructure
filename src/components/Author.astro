---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    name: string;
    role: string;
    affiliation: string;
    avatar: ImageMetadata;
    linkedin: string;
    researchGroup: string;
    researchGroupLabel: string;
}

const {
    name,
    role,
    affiliation,
    avatar,
    linkedin,
    researchGroup,
    researchGroupLabel,
} = Astro.props;
---

<section
    id="author"
    class="page-container page-section scroll-mt-6"
>
    <div class="author-card flex flex-col items-center gap-8 p-6 sm:p-10 md:flex-row md:items-center md:gap-10">
        <div class="shrink-0">
            <Image
                src={avatar}
                alt={`Portrait of ${name}`}
                width={220}
                height={220}
                loading="lazy"
                class="author-avatar h-40 w-40 object-cover sm:h-52 sm:w-52"
            />
        </div>

        <div class="text-center md:text-left">
            <p class="author-kicker">
                About the author
            </p>
            <h2 class="author-heading">
                {name}
            </h2>
            <p class="author-role">{role}</p>
            <p class="author-affiliation">{affiliation}</p>

            <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row md:justify-start">
                <a
                    href={linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="author-link inline-flex items-center justify-center gap-2.5 rounded-full border px-5 py-3 transition-colors"
                >
                    <svg
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"></path>
                    </svg>
                    LinkedIn
                </a>
                <a
                    href={researchGroup}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="author-link inline-flex items-center justify-center gap-2.5 rounded-full border px-5 py-3 transition-colors"
                >
                    <svg
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    {researchGroupLabel}
                </a>
            </div>
        </div>
    </div>
</section>
