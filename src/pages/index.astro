---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero";
import Gallery from "../components/Gallery";
import Author from "../components/Author.astro";
import authorAvatar from "../assets/author-avatar.jpg";
import type { ThumbnailImage } from "../data/variants";

// Sample thumbnails are generated by preprocessing/preprocess.py into
// src/assets/thumbnails/<sample-id>.png. Optimize each one with Astro's image
// pipeline and hand the resulting URLs to the React island, which cannot use
// the `<Image />` component itself.
const thumbnailModules = import.meta.glob<{ default: ImageMetadata }>(
    "../assets/thumbnails/*.png",
    { eager: true },
);

const thumbnails: Record<string, ThumbnailImage> = {};
await Promise.all(
    Object.entries(thumbnailModules).map(async ([path, module]) => {
        const id = path.slice(path.lastIndexOf("/") + 1).replace(/\.png$/, "");
        const image = await getImage({ src: module.default, format: "webp" });
        thumbnails[id] = {
            src: image.src,
            srcSet: image.srcSet?.attribute || undefined,
            width: module.default.width,
            height: module.default.height,
        };
    }),
);
---

<Layout
    title="Food Microstructure — 3D Atlas"
    description="A curated collection of high-resolution 3D reconstructions of food microstructure."
>
    <Hero />
    <Gallery client:load thumbnails={thumbnails} />
    <Author
        name="Ria Rodriguez"
        role="PhD Fellow, Structural Food Science"
        affiliation="Ingredient and Dairy Technology, University of Copenhagen"
        bio=""
        avatar={authorAvatar}
        linkedin="https://www.linkedin.com/in/ria-rodriguez-0650b0204/"
        researchGroup="https://food.ku.dk/english/research_at_food/research-projects/2025/establishing-a-food-microstructure-group/"
        researchGroupLabel="Food Microstructure group"
    />
</Layout>
